<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="431.0" prefWidth="643.0" styleClass="background" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" >

    <center>
        <VBox alignment="CENTER" prefHeight="470.0" prefWidth="643.0" spacing="30.0" BorderPane.alignment="CENTER">
            <children>
                <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="261.0" prefWidth="643.0" styleClass="title3" text="Êtes-vous sûr de vouloir supprimer ?" textAlignment="CENTER" wrapText="true" />
                
                <HBox alignment="CENTER" spacing="40.0" style="-fx-spacing: 100;">
                    <children>
                        <Button onAction="#onCancel" prefHeight="113.0" prefWidth="179.0" styleClass="button2" text="Non" />
                        <Button onAction="#onConfirm" prefHeight="110.0" prefWidth="177.0" styleClass="button1" text="Oui" />
                    </children>
               <VBox.margin>
                  <Insets bottom="60.0" />
               </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets top="40.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
