<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="840.0" prefWidth="1540.0" styleClass="background" stylesheets="@../../css/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.page.ControllerPagePlateau1J">
   <Button layoutX="5.0" layoutY="5.0" mnemonicParsing="false" onAction="#QuitGame" prefHeight="50.0" prefWidth="75.0" style="-fx-background-color: transparent;">
      <graphic>
         <ImageView fitHeight="50.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../img/retour.png" />
            </image>
         </ImageView>
      </graphic>
   </Button>
   <Label fx:id="resCoup" alignment="CENTER" layoutX="100.0" layoutY="10.0" prefHeight="100.0" prefWidth="1050.0" styleClass="titleresultat1" textFill="RED" />
   <HBox alignment="CENTER_LEFT" layoutX="1177.0" layoutY="10.0" prefHeight="100.0" prefWidth="350.0">
      <children>
           <Label styleClass="title3" text="Score : " textFill="WHITE" />
         <Label fx:id="labelScore" prefHeight="150.0" prefWidth="22.0" styleClass="infoNombre" text="0" textFill="WHITE">
            <font>
               <Font size="24.0" />
            </font>
            <HBox.margin>
               <Insets top="10.0" />
            </HBox.margin>
         </Label>
      </children>
   </HBox>
   <ScrollPane fx:id="scrollPaneTimeline" fitToHeight="true" hbarPolicy="NEVER" layoutX="25.0" layoutY="125.0" pannable="true" prefHeight="220.0" prefWidth="1490.0" stylesheets="@../../css/app.css" vbarPolicy="NEVER">
      <content>
      
                      <!-- Cercles (ligne centrée) -->
          <HBox fx:id="hBoxTimeline" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefWidth="50000.0" spacing="20" style="-fx-background-color: #262538; -fx-spacing: 30;" styleClass="hboxcards">
            <padding>
               <Insets bottom="20.0" left="20.0" />
            </padding></HBox>
      </content>
   </ScrollPane>
   <HBox alignment="BOTTOM_CENTER" layoutX="25.0" layoutY="360.0" prefHeight="470.0" prefWidth="1490.0" spacing="25.0">
      <children>
         <VBox alignment="CENTER" prefHeight="440.0" prefWidth="374.0">
            <children>
                 <Label styleClass="title3" text="Pioche" textFill="white" />
               <HBox alignment="CENTER" prefHeight="80.0" prefWidth="374.0">
                  <children>
                       <Label alignment="CENTER" contentDisplay="CENTER" styleClass="title4" text="Carte restante : " textFill="white" />
                     <Label fx:id="piocheCarteLabel" alignment="CENTER" prefHeight="80.0" styleClass="infoNombre" text="0" textFill="white">
                        <HBox.margin>
                           <Insets top="5.0" />
                        </HBox.margin>
                     </Label>
                  </children>
               </HBox>
               <StackPane fx:id="spPile" prefHeight="250.0" prefWidth="374.0" />
            </children>
         </VBox>
      
                      <!-- Infos joueur -->
          <VBox alignment="CENTER" prefHeight="450.0" prefWidth="1078.0" spacing="5">
              <Label fx:id="labelPlayerName" styleClass="title3" text="Nom Joueur" textFill="white" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                    <Label styleClass="title3" text="Cartes restantes : " textFill="white" />
                  <Label fx:id="labelRemainingCards" prefHeight="101.0" prefWidth="22.0" styleClass="infoNombre" text="0" textFill="white">
                     <HBox.margin>
                        <Insets top="10.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <ScrollPane hbarPolicy="NEVER" prefHeight="220.0" stylesheets="@../../css/app.css" vbarPolicy="NEVER">
               <content>
                  <HBox fx:id="HBoxCards" alignment="CENTER" prefHeight="220.0" prefWidth="1075.0" spacing="20.0" style="-fx-spacing: 30; -fx-background-color: #262538;" />
               </content>
            </ScrollPane>
          </VBox>
      </children>
   </HBox>

</AnchorPane>
