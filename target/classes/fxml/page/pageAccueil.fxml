<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="840.0" prefWidth="1540.0" styleClass="background" stylesheets="@../../css/app.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.page.ControllerPageAccueil">
   <children>
      <HBox alignment="CENTER" layoutY="25.0" prefHeight="100.0" prefWidth="1540.0">
         <children>
            <ImageView fitHeight="125.0" fitWidth="700.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/timeline.png" />
               </image>
            </ImageView>
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutY="93.0" prefHeight="747.0" prefWidth="1540.0" spacing="16.0">
         <children>
            <VBox alignment="CENTER" prefHeight="840.0" prefWidth="500.0">
               <children>
                  <ImageView fitHeight="400.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/carteDeGauche.png" />
                     </image>
                  </ImageView>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="840.0" prefWidth="500.0" spacing="50.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="568.0" prefWidth="500.0" style="-fx-spacing: 60;">
                     <children>
                        <Button alignment="CENTER" contentDisplay="RIGHT" graphicTextGap="110.0" mnemonicParsing="false" onAction="#onNewGame" prefHeight="100.0" prefWidth="500.0" styleClass="button1" text="Nouvelle partie" textAlignment="CENTER" wrapText="true">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <font>
                              <Font size="45.0" />
                           </font>
                        </Button>
                        <Button alignment="CENTER" contentDisplay="CENTER" disable="true" mnemonicParsing="false" onAction="#onLoadGame" prefHeight="100.0" prefWidth="500.0" styleClass="button1" text="Charger une partie" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="45.0" />
                           </font></Button>
                        <Button alignment="CENTER" contentDisplay="CENTER" graphicTextGap="110.0" mnemonicParsing="false" onAction="#onSelectionDeck" prefHeight="100.0" prefWidth="500.0" styleClass="button1" text="Gestion des decks" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="45.0" />
                           </font></Button>
                     </children>
                     <padding>
                        <Insets top="50.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="840.0" prefWidth="500.0">
               <children>
                  <ImageView fitHeight="400.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../img/carteDeDroite.png" />
                     </image>
                  </ImageView>
               </children></VBox>
         </children>
      </HBox>
      <Button layoutX="15.0" layoutY="15.0" mnemonicParsing="false" onAction="#onExitApp" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: transparent;">
         <graphic>
            <ImageView fitHeight="50.0" fitWidth="50.0" onDragDetected="#onExitApp" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/quit.png" />
               </image></ImageView>
         </graphic>
      </Button>
      <Button layoutX="1455.0" layoutY="15.0" mnemonicParsing="false" onAction="#onCredit" prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: transparent;">
         <graphic>
            <ImageView fitHeight="50.0" fitWidth="50.0" onDragDetected="#onCredit" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../img/rules.png" />
               </image>
            </ImageView>
         </graphic></Button>
   </children>
</AnchorPane>
