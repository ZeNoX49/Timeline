package application.io;

import java.io.File;
import java.io.IOException;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.ObjectMapper;

import application.model.Carte;
import application.pojo.CardPOJO;
import application.pojo.DeckPOJO;

public class JSONCardLoader extends CardLoader {

    private static final String PATH = "data.json";

    @Override
    public void load() {

        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.disable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES);

        try {
            File file = new File(PATH);

            if (!file.exists()) {
            	System.out.println("R�pertoire courant : " + System.getProperty("user.dir"));
                System.err.println("Erreur : Le fichier " + PATH + " est introuvable.");
                return;
            }

            DeckPOJO result = objectMapper.readValue(file, DeckPOJO.class);

            if (result == null || result.cards == null) {
                System.err.println("Erreur : Donnees JSON invalides ou vides.");
                return;
            }

            setTitle(result.name);

            int pos = 0;
            for (CardPOJO cardP : result.cards) {
                addCard(new Carte(cardP, pos++));
            }

            System.out.println("Deck \"" + result.name + "\" charge avec succes (" + result.cards.length + " cartes).");

        } catch (JsonProcessingException e) {
            System.err.println("Erreur de traitement JSON : " + e.getMessage());
        } catch (IOException e) {
            System.err.println("Erreur de lecture du fichier de donn�es : " + e.getMessage());
            e.printStackTrace();
        }
    }
}
