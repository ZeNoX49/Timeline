package application.model;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.List;

public class Hand implements Serializable{
	private static final long serialVersionUID = 1L;

	private Carte selectedCard;
    private List<Carte> cards;
    
    public Hand() {
        cards = new ArrayList<>();
        selectedCard = null;
    }
     
    public void addCard(Carte card) {
    	cards.add(card);
    }
    
    public boolean hasMoreCards() {
    	return !cards.isEmpty();
    }

	public List<Carte> getCards() {
		return cards;
	}

	public boolean hasOneCardSelected() {
		return selectedCard != null;
	}

	public Carte getSelectedCard() {
		return selectedCard;
	}

	public void removeCard(Carte card) {
		cards.remove(card);
	}
	
}
