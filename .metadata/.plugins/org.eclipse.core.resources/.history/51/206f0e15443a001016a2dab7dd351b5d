/* ========================= */
/*           FONTS           */
/* ========================= */
@font-face {
    font-family: 'Poppins';
    src: url('../font/Poppins-Thin.ttf');
    font-weight: 100;
}

@font-face {
    font-family: 'Poppins';
    src: url('../font/Poppins-Light.ttf');
    font-weight: 300;
}

@font-face {
    font-family: 'Poppins';
    src: url('../font/Poppins-Regular.ttf');
    font-weight: 400;
}

@font-face {
    font-family: 'Poppins';
    src: url('../font/Poppins-Medium.ttf');
    font-weight: 500;
}

@font-face {
    font-family: 'Poppins';
    src: url('../font/Poppins-Bold.ttf');
    font-weight: 800;
}

.button1 {
    -fx-background-color: linear-gradient(to bottom, #ffa733, #d07a00);
    -fx-text-fill: #fff3d1;
    -fx-font-family: 'Poppins';
    -fx-font-size: 60px;
    -fx-font-weight: bold;
    -fx-background-radius: 12;
    -fx-padding: 10 20 10 20;
    -fx-cursor: hand;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 4, 0, 0, 2);
    -fx-border-color: #9e5e00;
    -fx-border-radius: 12;
}
.button2 {
    -fx-background-color: linear-gradient(to bottom, #ffe49e, #ffc470);
    -fx-text-fill: #c36504;
    -fx-font-family: 'Poppins', sans-serif;
    -fx-font-size: 50px;
    -fx-font-weight: bold;
    -fx-background-radius: 12;
    -fx-padding: 10 20 10 20;
    -fx-cursor: hand;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 3, 0, 0, 2);
    -fx-border-color: #d07a00;
    -fx-border-radius: 12;
}
.button1:hover, .button2:hover {
    -fx-background-color: #f7c650;
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 6, 0.3, 0, 2);
}

.button1:pressed, .button2:pressed {
    -fx-background-color: #a85f00;
}
.button-active {
    -fx-text-fill: #803b00;
	-fx-background-color: linear-gradient(to bottom, #ffe49e, #d39a4a);
    -fx-font-weight: bold;
    -fx-effect: dropshadow(three-pass-box, #fff8e199, 24, 0.7, 0, 5);
    -fx-border-color: #fff8e1;
    -fx-border-width: 3px;
    -fx-border-radius: 14;
    -fx-background-radius: 14;
    -fx-font-size: 65px;
}
.button-with-shadow {
    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 5, 0.2, 2, 2);
}


.background {
    -fx-background-color: linear-gradient(to bottom, #2d2b3f, #262538);
}


.label {
    -fx-font-family: 'Poppins', sans-serif;
    -fx-text-fill: #ffeabf;
}

